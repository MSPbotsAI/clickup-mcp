# ─── Transport ───────────────────────────────────────────────────────────────
# http   — for HTTP gateway deployments (default). Per-request token via the
#          X-Clickup-Token header; a request with no header gets 401. There is
#          no fallback to CLICKUP_API_TOKEN below on this path.
# stdio  — for Claude Desktop / local CLI use only (single user, no gateway)
MCP_TRANSPORT=http

# Port for HTTP transport (default: 8080)
# MCP_HTTP_PORT=8080

# Host for HTTP transport (default: 0.0.0.0)
# MCP_HTTP_HOST=0.0.0.0

# ─── ClickUp Credentials ────────────────────────────────────────────────────
# Only used when MCP_TRANSPORT=stdio (local dev / Claude Desktop). Ignored
# entirely by the HTTP/gateway transport — see note above.
# Get your personal API token from: ClickUp Settings > Apps > API Token
CLICKUP_API_TOKEN=pk_xxxxx

# Optional: override the default ClickUp API base URL
# CLICKUP_BASE_URL=https://api.clickup.com/api/v2
